{
  "manifest_version": 3,
  "name": "VelocityDM Download Manager",
  "version": "1.0.0",
  "description": "Turbo-charged downloads for Chrome: video sniffing, batch links, mirrors, BitTorrent and magnet, via the native VelocityDM engine.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "webRequest",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VelocityDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}