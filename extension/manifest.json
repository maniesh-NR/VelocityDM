{
  "manifest_version": 3,
  "name": "VelocityDM Companion",
  "version": "1.0.0",
  "description": "Sends downloads to the VelocityDM desktop daemon: captures media links from pages, adds context-menu downloads, bridges native messaging, and reports download notifications.",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "webRequest",
    "notifications",
    "alarms"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "VelocityDM Companion",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  }
}
